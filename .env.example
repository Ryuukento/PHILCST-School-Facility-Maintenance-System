APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Must be false in production — set to true only for local development.
# Leaving this true in production leaks stack traces and internal error
# details to end users/attackers.
APP_DEBUG=false
APP_URL=http://localhost/School_Facility_Maintenance_System/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Used only by database/seeders/DatabaseSeeder.php to create local
# dev/test accounts. Not real credentials — set your own values in your
# local .env; never put real credentials here in .env.example.
# Username is the field actually used to log in (see AuthController::login());
# email is kept as a separate required/unique contact attribute only.
SEED_SUPER_ADMIN_USERNAME=superadmin
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=change-me-super-admin
SEED_MAINTENANCE_ADMIN_USERNAME=maintenanceadmin
SEED_MAINTENANCE_ADMIN_EMAIL=maintenance-admin@example.com
SEED_MAINTENANCE_ADMIN_PASSWORD=change-me-maint-admin

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

DB_BACKUP_MYSQLDUMP_PATH=


SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SFMS_SMTP_HOST=smtp.gmail.com
SFMS_SMTP_PORT=587
SFMS_SMTP_USERNAME=your-smtp-username@example.com
SFMS_SMTP_PASSWORD=your-smtp-password
SFMS_MAIL_FROM_ADDRESS=your-sender@example.com
SFMS_MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
