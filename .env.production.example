# =====================================================================
# SFMS — PRODUCTION .env TEMPLATE (Hostinger, https://philcstmaintenance.com)
#
# Copy to public_html/.env on the server and fill in every <SET_ME>.
# This template contains NO real secrets and is safe to commit.
# NEVER commit the real production .env (it is in .gitignore).
# =====================================================================

APP_NAME="PHILCST SFMS"
APP_ENV=production
# Generate ONCE for production (see deployment notes) and keep it.
# Do not reuse the local development key.
APP_KEY=<SET_ME: base64:... generated for production>
APP_DEBUG=false
APP_URL=https://philcstmaintenance.com
# (Timezone is fixed to Asia/Manila in config/app.php — no variable needed.)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Production logging: warnings and errors only, rotated daily. (At "debug"
# every request writes an info line, which grows the log quickly.)
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Hostinger MySQL — values from hPanel > Databases > Management.
# DB_HOST is the MySQL host shown there (for a site on the same Hostinger
# account this is usually "localhost", which is Hostinger's own MySQL
# server — not XAMPP). Database and user names look like u123456789_xxx.
DB_CONNECTION=mysql
DB_HOST=<SET_ME: MySQL host from hPanel>
DB_PORT=3306
DB_DATABASE=<SET_ME: u..._database>
DB_USERNAME=<SET_ME: u..._user>
DB_PASSWORD=<SET_ME: database password>

# Sessions/cache/queue use database tables (sessions, cache, jobs), which
# must exist in the production database.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Laravel mail (not used for SFMS notifications; keep as log unless needed)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@philcstmaintenance.com"
MAIL_FROM_NAME="${APP_NAME}"

# SFMS email notifications (public/backend/services/EmailService.php).
# Optional — leave blank if email sending is not set up yet.
SFMS_SMTP_HOST=<SET_ME or leave blank>
SFMS_SMTP_PORT=587
SFMS_SMTP_USERNAME=<SET_ME or leave blank>
SFMS_SMTP_PASSWORD=<SET_ME or leave blank>
SFMS_MAIL_FROM_ADDRESS=<SET_ME or leave blank>
SFMS_MAIL_FROM_NAME="${APP_NAME}"

# Only used by the local "php artisan backup" command; not needed on Hostinger.
DB_BACKUP_MYSQLDUMP_PATH=
